<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <LinearLayout
        android:id="@+id/resultsRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="75sp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUIZ COMPLETED!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:gravity="center"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Here is how you performed"
            android:textSize="17sp"
            android:textColor="#627D98"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:id="@+id/tvFinalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 / 10"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#2457A7"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2457A7"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Best Score: 0 / 10"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#219653"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvPerformance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excellent Performance!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#219653"
            android:gravity="center"
            android:layout_marginBottom="35dp"/>

        <Button
            android:id="@+id/btnPlayAgain"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PLAY AGAIN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2457A7"/>

        <Button
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="BACK TO HOME"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2457A7"
            android:backgroundTint="#DCE7F7"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>